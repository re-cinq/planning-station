{
  "name": "@re-cinq/planning-yjs",
  "version": "0.5.0",
  "description": "The plan's Yjs bridge: a headless BlockNote schema and block <-> Yjs conversions for Node and browsers.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "yjs": "^13.6.27"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.2",
    "@re-cinq/planning-document": "^0.5.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "yjs": "^13.6.32"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-cinq/planning-station.git",
    "directory": "packages/planning-yjs"
  }
}
