{
  "name": "@re-cinq/planning-editor",
  "version": "0.3.2",
  "description": "The collaborative plan editor: a React component on BlockNote, template-guarded and themed by CSS variables.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./transports/hocuspocus": {
      "types": "./dist/transports/hocuspocus.d.ts",
      "default": "./dist/transports/hocuspocus.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.27"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.54.2",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@floating-ui/react": "^0.27.20",
    "@hocuspocus/provider": "^4.7.0",
    "@re-cinq/planning-document": "^0.3.0",
    "@re-cinq/planning-yjs": "^0.3.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.104.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest-browser-react": "^2.3.0",
    "yjs": "^13.6.32"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-cinq/planning-station.git",
    "directory": "packages/planning-editor"
  }
}
