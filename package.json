{
  "name": "@re-cinq/planning-editor",
  "version": "0.3.0",
  "description": "The collaborative plan editor: a React component on BlockNote, template-guarded and themed by CSS variables.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./transports/hocuspocus": {
      "types": "./dist/transports/hocuspocus.d.ts",
      "default": "./dist/transports/hocuspocus.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "^13.6.27"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.54.2",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@floating-ui/react": "^0.27.20",
    "@hocuspocus/provider": "^4.7.0",
    "@re-cinq/planning-document": "git+https://github.com/re-cinq/planning-station.git#planning-document-dist-v0.3.0",
    "@re-cinq/planning-yjs": "git+https://github.com/re-cinq/planning-station.git#planning-yjs-dist-v0.3.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-cinq/planning-station.git",
    "directory": "packages/planning-editor"
  }
}
